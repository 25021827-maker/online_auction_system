<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #000000;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.user.ProfileController">

    <center>
        <ScrollPane fitToHeight="true"
                    fitToWidth="true"
                    pannable="true"
                    style="-fx-background-color: #000000;">
            <content>
        <StackPane alignment="CENTER" style="-fx-background-color: #000000;">

            <VBox alignment="TOP_CENTER"
                  minHeight="1700"
                  prefWidth="1280.0"
                  maxWidth="1280.0"
                  spacing="20"
                  style="-fx-padding: 30 30 220 30; -fx-background-color: #000000;">

                <Label text="PROFILE" textFill="#ffdd00">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <VBox maxWidth="500" spacing="15" style="-fx-background-color: #ffdd00; -fx-padding: 20; -fx-background-radius: 12;">
                    <children>
                        <Label text="ACCOUNT INFORMATION">
                            <font>
                                <Font name="System Bold" size="18" />
                            </font>
                        </Label>

                        <Separator />

                        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 5 0 10 0;">
                            <children>
                                <ImageView fx:id="imgProfileAvatar"
                                           fitHeight="100.0"
                                           fitWidth="100.0"
                                           pickOnBounds="true"
                                           preserveRatio="true" />

                                <VBox spacing="10" alignment="CENTER_LEFT">
                                    <children>
                                        <Label text="Profile Picture" style="-fx-font-weight: bold; -fx-text-fill: #000000; -fx-font-size: 13px;" />
                                        <Button onAction="#handleUploadAvatar"
                                                style="-fx-background-color: #000000; -fx-text-fill: #ffdd00; -fx-background-radius: 6; -fx-cursor: hand;"
                                                text="UPLOAD AVATAR">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Separator />

                        <HBox spacing="10">
                            <children>
                                <Label text="Username:">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <Label fx:id="lblUsername" />
                            </children>
                        </HBox>

                        <HBox spacing="10">
                            <children>
                                <Label text="Balance:">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <Label fx:id="lblBalance" />
                            </children>
                        </HBox>

                        <HBox spacing="10">
                            <children>
                                <Label text="Available Balance:">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <Label fx:id="lblAvailableBalance" />
                            </children>
                        </HBox>

                        <HBox spacing="10">
                            <children>
                                <Label text="Held For Bids:">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <Label fx:id="lblHeldBalance" />
                            </children>
                        </HBox>

                        <Button onAction="#handleAddMoney" prefWidth="150" style="-fx-background-color: #000000; -fx-text-fill: #ffdd00; -fx-background-radius: 8;" text="DEPOSIT" textFill="#ffdd00">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <Label text="DEPOSIT FUNDS VIA THE QR CODE BELOW" textFill="#ffdd00">
                    <font>
                        <Font name="System Bold" size="16" />
                    </font>
                </Label>

                <ImageView fx:id="qrImageView" fitHeight="220" fitWidth="220" preserveRatio="true" />

                <Button onAction="#chooseProofImage" prefWidth="180" style="-fx-background-color: #ffdd00; -fx-background-radius: 8;" text="UPLOAD IMAGE TO VERIFY" textFill="#000000">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Label fx:id="proofLabel" style="-fx-text-fill: #ffdd00" text="Verification photo missing" />

                <Button onAction="#handleFakePayment" prefWidth="180" style="-fx-background-color: #ffdd00; -fx-text-fill: #000000; -fx-background-radius: 8;" text="CONFIRM PAYMENT">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <VBox maxWidth="500" spacing="10" style="-fx-background-color: #ffdd00; -fx-padding: 20; -fx-background-radius: 8;">
                    <children>
                        <Label text="MY AUCTIONS">
                            <font>
                                <Font name="System Bold" size="18" />
                            </font>
                        </Label>

                        <Separator />

                        <VBox fx:id="myProductsBox" spacing="10" />
                    </children>
                </VBox>

                <VBox maxWidth="1150"
                      spacing="10"
                      style="-fx-background-color: #ffdd00; -fx-padding: 20; -fx-background-radius: 8;">
                    <children>
                        <Label text="WALLET TRANSACTION HISTORY">
                            <font>
                                <Font name="System Bold" size="18" />
                            </font>
                        </Label>

                        <Separator />

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>
                                <Label fx:id="walletHistoryStatusLabel"
                                       style="-fx-text-fill: #000000; -fx-font-weight: bold;"
                                       text="Loading transaction history..." />

                                <Button onAction="#handleRefreshWalletHistory"
                                        prefWidth="160"
                                        style="-fx-background-color: #000000; -fx-text-fill: #ffdd00; -fx-background-radius: 8;"
                                        text="REFRESH HISTORY">
                                    <font>
                                        <Font name="System Bold" size="11.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <TableView fx:id="walletTransactionsTable"
                                   prefHeight="520"
                                   minHeight="520"
                                   maxHeight="520"
                                   fixedCellSize="42"
                                   style="-fx-background-color: #ffffff; -fx-control-inner-background: #fff8c6; -fx-table-cell-border-color: #d9c600; -fx-font-size: 12px;">
                            <columns>
                                <TableColumn fx:id="txTimeColumn"
                                             text="Time"
                                             prefWidth="160"
                                             resizable="true" />

                                <TableColumn fx:id="txTypeColumn"
                                             text="Type"
                                             prefWidth="160"
                                             resizable="true" />

                                <TableColumn fx:id="txAmountColumn"
                                             text="Amount"
                                             prefWidth="120"
                                             resizable="true" />

                                <TableColumn fx:id="txBalanceBeforeColumn"
                                             text="Balance Before"
                                             prefWidth="140"
                                             resizable="true" />

                                <TableColumn fx:id="txBalanceAfterColumn"
                                             text="Balance After"
                                             prefWidth="140"
                                             resizable="true" />

                                <TableColumn fx:id="txAvailableBeforeColumn"
                                             text="Available Before"
                                             prefWidth="150"
                                             resizable="true" />

                                <TableColumn fx:id="txAvailableAfterColumn"
                                             text="Available After"
                                             prefWidth="150"
                                             resizable="true" />

                                <TableColumn fx:id="txNoteColumn"
                                             text="Note"
                                             prefWidth="300"
                                             resizable="true" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

            </VBox>
        </StackPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-background-color: #000000; -fx-border-color: #ffdd00 transparent transparent transparent; -fx-border-width: 2 0 0 0; -fx-padding: 14 0 18 0;">
            <children>
                <Button onAction="#goHome"
                        prefHeight="44"
                        prefWidth="240"
                        style="-fx-background-color: #ffdd00; -fx-background-radius: 10; -fx-text-fill: #000000; -fx-font-size: 14; -fx-font-weight: bold;"
                        text="BACK TO HOME">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </bottom>
</BorderPane>
