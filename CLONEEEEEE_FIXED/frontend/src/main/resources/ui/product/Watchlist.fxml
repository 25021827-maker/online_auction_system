<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="750.0" prefWidth="1280.0" styleClass="watchlist-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@../../style/pages/watch-list.css" fx:controller="Controller.product.WatchlistController">
    <children>
        <Label styleClass="watchlist-title" text="My Watchlist" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="30.0" />

        <Button fx:id="btnBack" mnemonicParsing="false" onAction="#goBack" prefHeight="35.0" prefWidth="90.0" styleClass="watchlist-back-btn" text="Back" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="30.0" />

        <ScrollPane fitToWidth="true" styleClass="watchlist-scroll" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0">
            <content>
                <FlowPane fx:id="watchlistContainer" hgap="20.0" vgap="20.0" styleClass="watchlist-grid" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>