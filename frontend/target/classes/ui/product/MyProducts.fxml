<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane
        fitToWidth="true"
        fitToHeight="true"
        pannable="true"
        hbarPolicy="NEVER"
        vbarPolicy="AS_NEEDED"
        styleClass="main-scroll"
        stylesheets="@../../style/main.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="Controller.product.MyProductsController">

    <content>
        <StackPane alignment="CENTER" style="-fx-background-color: transparent;">

            <VBox
                    alignment="TOP_CENTER"
                    spacing="25"
                    fillWidth="true"
                    prefWidth="1280.0"
                    maxWidth="1280.0"
                    styleClass="main-background">

                <padding>
                    <Insets
                            top="25"
                            right="25"
                            bottom="25"
                            left="25"/>
                </padding>

                <Label
                        text="MY PRODUCTS"
                        styleClass="page-title"/>

                <FlowPane
                        fx:id="productsContainer"
                        alignment="TOP_CENTER"
                        hgap="20"
                        vgap="20"
                        maxWidth="Infinity">

                    <padding>
                        <Insets
                                top="10"
                                right="10"
                                bottom="10"
                                left="10"/>
                    </padding>

                </FlowPane>

                <Button
                        text="Quay lại"
                        prefWidth="160"
                        onAction="#goBack"
                        styleClass="secondary-button"/>

            </VBox>
        </StackPane>
    </content>

</ScrollPane>